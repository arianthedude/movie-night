# Postgres
POSTGRES_USER=movienight
POSTGRES_PASSWORD=movienight
POSTGRES_DB=movienight
POSTGRES_PORT=5432
DATABASE_URL=postgres://movienight:movienight@localhost:5432/movienight

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_URL=http://localhost:3000

# TMDB — https://www.themoviedb.org/settings/api
# Exposed to the browser (client-side fetch). Fine for a private friends app.
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-key
# Posters are always loaded via /api/tmdb-image (image.tmdb.org is often DNS-blocked in browsers).

# App (docker compose)
APP_PORT=3000
