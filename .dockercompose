services:
  migrate:
    build: .
    user: root
    working_dir: /app
    command: ["npx", "tsx", "src/db/migrate.ts"]
    restart: "no"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      DATABASE_URL: ${DATABASE_URL:?DATABASE_URL is required}

  app:
    build: .
    restart: unless-stopped
    ports:
      - "${APP_PORT:-3000}:3000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      NODE_ENV: production
      DATABASE_URL: ${DATABASE_URL:?DATABASE_URL is required}
      AUTH_SECRET: ${AUTH_SECRET:?AUTH_SECRET is required}
      AUTH_URL: ${AUTH_URL:-http://localhost:3000}
      TMDB_API_KEY: ${TMDB_API_KEY:?TMDB_API_KEY is required}
    depends_on:
      migrate:
        condition: service_completed_successfully